# Copy outside the checkout and chmod 600. Use single quotes for literal secrets.
MYWAY_RELEASE=replace-with-immutable-release-tag
PUBLIC_ORIGIN=https://mywaygraph.com
# Set to www.mywaygraph.com only after its DNS is ready.
CADDY_WWW_SITE=http://www.disabled.invalid
REGISTRATION_ENABLED=false
POSTGRES_ADMIN_PASSWORD='replace-admin-password'
POSTGRES_MIGRATION_PASSWORD='replace-migration-password'
POSTGRES_PASSWORD='replace-runtime-password'
AUTH_SECRET='replace-with-a-random-secret-at-least-32-characters'
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM='MyWay <noreply@mywaygraph.com>'
SMTP_USERNAME='replace-brevo-smtp-user'
SMTP_PASSWORD='replace-brevo-smtp-key'
