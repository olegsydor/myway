# Local development only. Copy to .env and set your own database credentials.
APP_ENV=development
POSTGRES_DB=myway
POSTGRES_USER=myway
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
PUBLIC_ORIGIN=http://localhost:5173
AUTH_SECRET=replace-with-a-random-secret-before-production
REGISTRATION_ENABLED=true
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
VERIFY_TTL_HOURS=24
RESET_TTL_MINUTES=30
# smtp for real mail; file is an explicit development-only private mail sink.
MAIL_MODE=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=My Way <noreply@localhost>
MAIL_SINK_PATH=/tmp/myway-mail
